{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "arena:instellar_device",
      "item": {
        "arena:instellar_device": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/instellar_device_3d",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.instellar_device"
      },
      "render_controllers": ["controller.render.item_default"]
    }
  }
}
