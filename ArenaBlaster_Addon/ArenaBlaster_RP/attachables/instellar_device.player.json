{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "arena:instellar_device",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_glint"
      },
      "textures": {
        "default": "textures/items/instellar_device_3d",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.instellar_device"
      },
      "scripts": {
        "pre_animation": [
          "v.main_hand = c.item_slot == 'main_hand';",
          "v.off_hand = c.item_slot == 'off_hand';"
        ],
        "animate": [
          { "firstperson_main_hand": "v.main_hand && c.is_first_person" },
          { "firstperson_off_hand": "v.off_hand && c.is_first_person" },
          { "thirdperson_main_hand": "v.main_hand && !c.is_first_person" },
          { "thirdperson_off_hand": "v.off_hand && !c.is_first_person" },
          { "charge": "query.is_using_item" }
        ]
      },
      "animations": {
        "firstperson_main_hand": "animation.instellar_device.firstperson_main_hand",
        "firstperson_off_hand": "animation.instellar_device.firstperson_off_hand",
        "thirdperson_main_hand": "animation.instellar_device.thirdperson_main_hand",
        "thirdperson_off_hand": "animation.instellar_device.thirdperson_off_hand",
        "charge": "animation.instellar_device.charge"
      },
      "render_controllers": ["controller.render.item_default"]
    }
  }
}
